let currentLang = "es";

function setLang(lang) {
  currentLang = lang;

  // Actualizar atributo lang del documento
  document.documentElement.lang = lang;

  // Actualizar botones activos
  document.getElementById("btn-es").classList.toggle("active", lang === "es");
  document.getElementById("btn-en").classList.toggle("active", lang === "en");

  // Traducir todos los elementos con data-i18n
  document.querySelectorAll("[data-i18n]").forEach(el => {
    const key = el.getAttribute("data-i18n");
    if (translations[lang][key] !== undefined) {
      el.textContent = translations[lang][key];
    }
  });

  // Traducir elementos con HTML interno (data-i18n-html)
  document.querySelectorAll("[data-i18n-html]").forEach(el => {
    const key = el.getAttribute("data-i18n-html");
    if (translations[lang][key] !== undefined) {
      el.innerHTML = translations[lang][key];
    }
  });

  // Guardar preferencia
  try { localStorage.setItem("nz-lang", lang); } catch(e) {}

  // Limpiar respuesta del quiz al cambiar idioma
  document.getElementById("answer").textContent = "";
}

/* =========================================================
   QUIZ
========================================================= */

function answer(v) {
  const answerEl = document.getElementById("answer");
  const correctText = translations[currentLang].quiz_correct;
  const wrongText = translations[currentLang].quiz_wrong;

  answerEl.textContent = (v === "Wellington") ? correctText : wrongText;
}

/* =========================================================
   INICIALIZACIÓN
========================================================= */

// Cargar idioma guardado o detectar del navegador
(function initLang() {
  let saved = null;
  try { saved = localStorage.getItem("nz-lang"); } catch(e) {}

  if (saved === "es" || saved === "en") {
    setLang(saved);
  } else {
    // Detectar idioma del navegador
    const browserLang = (navigator.language || "es").toLowerCase();
    setLang(browserLang.startsWith("en") ? "en" : "es");
  }
})();

